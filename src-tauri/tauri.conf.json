{
  "productName": "Aether",
  "version": "0.1.0",
  "identifier": "com.aether.mcpclient",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: websocket:;"
    }
  },
  "bundle": {
    "publisher": "Nayeem Islam",
    "copyright": "© 2024 Nayeem Islam. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Cross-platform MCP client for Large Language Models",
    "longDescription": "A modern, cross-platform Multi-Client Protocol (MCP) client for Large Language Models, built with Tauri and Next.js for native performance and beautiful user experience."
  },
  "plugins": {
    "keyring": {},
    "store": {}
  }
}

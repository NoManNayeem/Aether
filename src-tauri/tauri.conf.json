{
  "productName": "Aether",
  "version": "0.1.0",
  "identifier": "com.aether.mcpclient",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: websocket:;"
    }
  },
  "plugins": {
    "keyring": {},
    "store": {}
  }
}
